# Пример файла с переменными окружения
# Скопируйте этот файл в .env и заполните своими значениями

# OpenAI (платно, возможны ограничения по региону)
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek — бесплатные лимиты (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Qwen / Alibaba DashScope — бесплатный tier (https://dashscope.aliyun.com)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
